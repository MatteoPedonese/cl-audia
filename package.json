{
  "name": "podcast-editor",
  "productName": "Podcast Editor",
  "version": "0.1.0",
  "description": "Editor audio semplice per podcast",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.podcasteditor.app",
    "productName": "Podcast Editor",
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/@huggingface/transformers/dist/*.web.*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg*",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": "nsis",
      "files": [
        "dist/**",
        "electron/**",
        "package.json",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
        "!node_modules/onnxruntime-web/**",
        "!node_modules/@huggingface/transformers/dist/*.web.*",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**"
      ]
    },
    "fileAssociations": [
      {
        "ext": "podcast",
        "name": "Progetto Podcast Editor",
        "role": "Editor"
      }
    ],
    "mac": {
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Podcast Editor usa il microfono per registrare la tua voce."
      },
      "target": "dmg",
      "category": "public.app-category.music",
      "files": [
        "dist/**",
        "electron/**",
        "package.json",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
        "!node_modules/onnxruntime-web/**",
        "!node_modules/@huggingface/transformers/dist/*.web.*",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**"
      ]
    },
    "directories": {
      "output": "release"
    },
    "afterPack": "build/adhoc-sign.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  }
}
